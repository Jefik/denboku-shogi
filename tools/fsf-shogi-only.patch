+#if defined(SHOGI_ONLY) && !defined(_WIN32)
+  // Shogi never reads the tables of hoppers and lame leapers (cannons, grasshoppers,
+  // nightriders, xiangqi and janggi elephants and horses): give their pages back.
+  auto release = [](void* p, size_t size) {
+      uintptr_t page = sysconf(_SC_PAGESIZE), start = ((uintptr_t)p + page - 1) & ~(page - 1),
+                end = ((uintptr_t)p + size) & ~(page - 1);
+      if (end > start)
+          madvise((void*)start, end - start, MADV_DONTNEED);
+  };
+  release(CannonTableH, sizeof(CannonTableH));
+  release(CannonTableV, sizeof(CannonTableV));
+  release(JanggiElephantTable, sizeof(JanggiElephantTable));
+  release(CannonDiagTable, sizeof(CannonDiagTable));
+  release(NightriderTable, sizeof(NightriderTable));
+  release(GrasshopperTableH, sizeof(GrasshopperTableH));
+  release(GrasshopperTableV, sizeof(GrasshopperTableV));
+  release(GrasshopperTableD, sizeof(GrasshopperTableD));
+#endif
 }
 
